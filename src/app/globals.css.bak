:root {
  --verde: #1f7a3d;
  --verde-oscuro: #165a2d;
  --amarillo: #f5c518;
  --fondo: #ffffff;
  --suave: #f4f8f5;
  --borde: #d9e3dc;
  --texto: #1c2a21;
  --texto-suave: #5b6b61;
  --error: #b3261e;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  background: var(--fondo);
  color: var(--texto);
  line-height: 1.5;
}

.centro {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background: var(--suave);
}
.tarjeta {
  width: 100%;
  max-width: 400px;
  background: var(--fondo);
  border: 1px solid var(--borde);
  border-top: 5px solid var(--amarillo);
  border-radius: 12px;
  padding: 28px;
  display: grid;
  gap: 14px;
}
.tarjeta h1 { margin: 0; font-size: 1.4rem; color: var(--verde-oscuro); }
.tarjeta p { margin: 0; color: var(--texto-suave); font-size: 0.95rem; }

label { display: grid; gap: 6px; font-weight: 600; font-size: 0.9rem; }
input {
  font: inherit;
  padding: 10px 12px;
  border: 1px solid var(--borde);
  border-radius: 8px;
  background: #fff;
}
input:focus { outline: 3px solid rgba(31, 122, 61, 0.25); border-color: var(--verde); }

.boton {
  font: inherit;
  font-weight: 700;
  padding: 11px 14px;
  border: 0;
  border-radius: 8px;
  background: var(--verde);
  color: #fff;
  cursor: pointer;
}
.boton:hover { background: var(--verde-oscuro); }
.boton:disabled { opacity: 0.6; cursor: wait; }
.boton.secundario { background: transparent; color: var(--verde-oscuro); border: 1px solid var(--borde); }
.boton.secundario:hover { background: var(--suave); }

.error {
  color: var(--error);
  background: #fdecea;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 0.92rem;
}

.app { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
.lateral {
  background: var(--verde-oscuro);
  color: #fff;
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.marca { color: #fff; text-decoration: none; font-weight: 800; font-size: 1.1rem; border-bottom: 3px solid var(--amarillo); padding-bottom: 10px; }
.lateral nav { display: grid; gap: 4px; flex: 1; align-content: start; }
.lateral nav a { color: #fff; text-decoration: none; padding: 9px 10px; border-radius: 8px; }
.lateral nav a:hover { background: rgba(255, 255, 255, 0.12); }
.lateral nav a[aria-current="page"] { color: var(--verde-oscuro); background: #e3f3ea; font-weight: 700; }
.quien { display: grid; gap: 4px; font-size: 0.9rem; }
.quien span { color: var(--amarillo); font-size: 0.82rem; }
.lateral .boton.secundario { color: #fff; border-color: rgba(255, 255, 255, 0.4); margin-top: 8px; width: 100%; }
.lateral .boton.secundario:hover { background: rgba(255, 255, 255, 0.12); }
.contenido { padding: 28px; }
.contenido h1 { margin-top: 0; color: var(--verde-oscuro); }
.subtitulo { color: var(--texto-suave); margin: -12px 0 20px; }
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 18px; }
.kpi, .panel { background: #fff; border: 1px solid var(--borde); border-radius: 12px; padding: 16px; }
.kpi { display: grid; gap: 4px; }
.kpi strong { color: var(--verde-oscuro); font-size: 1.8rem; line-height: 1.2; }
.kpi span { color: var(--texto-suave); font-size: 0.9rem; }
.panel { margin-bottom: 18px; }
.panel h2 { margin: 0 0 12px; color: var(--verde-oscuro); font-size: 1.2rem; }
.tabla-contenedor { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
th, td { padding: 10px; text-align: left; border-bottom: 1px solid var(--borde); white-space: nowrap; }
th { color: var(--texto-suave); font-size: 0.8rem; }
.barra-progreso { display: inline-block; vertical-align: middle; width: 90px; height: 10px; margin-right: 8px; overflow: hidden; border-radius: 8px; background: var(--suave); }
.barra-progreso.grande { display: block; width: min(100%, 520px); height: 14px; margin: 8px 0; }
.barra-progreso span { display: block; height: 100%; border-radius: inherit; background: var(--verde); }
.vacio { color: var(--texto-suave); text-align: center; padding: 18px 0; }
.panel .boton { display: inline-block; width: auto; text-decoration: none; }
.formulario { display: grid; gap: 14px; max-width: 760px; }
.formulario .boton { justify-self: start; }
.formulario select, .formulario textarea, .filtros select, .filtros input { width: 100%; font: inherit; padding: 10px 12px; border: 1px solid var(--borde); border-radius: 8px; background: #fff; color: var(--texto); }
.formulario input[type="text"], .formulario input[type="tel"], .formulario input[type="password"], .formulario input[type="number"], .formulario input[type="file"], .formulario input[type="search"] { width: 100%; min-height: 44px; font: inherit; padding: 10px 12px; border: 1px solid var(--borde); border-radius: 8px; background: #fff; color: var(--texto); }
.formulario-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
.formulario-grid > label, .campo-catalogo { min-width: 0; align-content: start; }
.campo-catalogo { position: relative; display: grid; gap: 4px; }
.campo-catalogo > input { width: 100%; min-height: 44px; font: inherit; padding: 10px 12px; border: 1px solid var(--borde); border-radius: 8px; background: #fff; color: var(--texto); }
.campo-catalogo > input:focus { outline: 3px solid rgba(31, 122, 61, 0.2); border-color: var(--verde); }
.campo-catalogo-sugerencias { position: absolute; z-index: 5; top: calc(100% - 24px); left: 0; right: 0; display: grid; max-height: 260px; overflow-y: auto; border: 1px solid var(--borde); border-radius: 8px; background: #fff; box-shadow: 0 8px 20px rgba(28, 42, 33, 0.14); }
.campo-catalogo-opcion { display: grid; gap: 2px; width: 100%; min-height: 44px; padding: 8px 12px; border: 0; border-bottom: 1px solid var(--borde); background: #fff; color: var(--texto); font: inherit; text-align: left; cursor: pointer; }
.campo-catalogo-opcion:last-child { border-bottom: 0; }
.campo-catalogo-opcion:hover, .campo-catalogo-opcion:focus-visible { background: var(--suave); outline: none; }
.campo-catalogo-detalle, .campo-catalogo-ayuda { color: var(--texto-suave); font-size: 0.82rem; }
.campo-catalogo-ayuda { min-height: 1.2em; margin: 0; }
.formulario > .error { grid-column: 1 / -1; }
.confirmacion-registro { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "encabezado" "autorizacion" "boton"; gap: 9px; min-width: 0; padding: 4px 0 0; border: 0; background: transparent; }
.confirmacion-registro-encabezado { grid-area: encabezado; min-width: 0; }
.confirmacion-registro h2 { margin: 0; color: var(--texto); font-size: 0.95rem; font-weight: 650; }
.confirmacion-registro-check { grid-area: autorizacion; grid-template-columns: 20px minmax(0, 1fr); align-items: start; gap: 8px; min-width: 0; padding: 8px 0; border: 0; background: transparent; font-size: 0.88rem; line-height: 1.45; cursor: pointer; }
.confirmacion-registro-check input { width: 18px; height: 18px; margin: 1px 0 0; accent-color: var(--verde); }
.confirmacion-registro-boton, .formulario .confirmacion-registro-boton { grid-area: boton; width: 100%; min-width: 0; min-height: 44px; justify-self: stretch; padding: 9px 16px; font-size: 0.92rem; white-space: normal; }
.confirmacion-registro-boton:not(:disabled):hover { background: var(--verde-oscuro); }
.confirmacion-registro-boton:focus-visible { outline: 3px solid rgba(31, 122, 61, 0.35); outline-offset: 3px; }
.filtros { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
.filtros input, .filtros select { flex: 1 1 180px; }
.aviso { padding: 10px 12px; border-radius: 8px; background: #fff6cc; color: #6a4d00; margin-bottom: 12px; }
.acciones { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.acciones .boton { width: auto; }
.acciones-form { display: flex; align-items: center; gap: 6px; }
.acciones-form select { min-width: 140px; font: inherit; padding: 7px; border: 1px solid var(--borde); border-radius: 8px; background: #fff; }
.boton.pequeno { width: auto; padding: 7px 10px; font-size: 0.84rem; }
.enlace-boton { display: inline-flex; align-items: center; text-decoration: none; }
.etiqueta { display: inline-block; margin-left: 4px; padding: 1px 7px; border-radius: 10px; background: var(--suave); color: var(--texto-suave); font-size: 0.75rem; }
.etiqueta.advertencia { background: #fff6cc; color: #6a4d00; }
.nota { color: var(--texto-suave); font-size: 0.85rem; }
.publico { width: min(100% - 32px, 760px); margin: 0 auto; padding: 28px 0; }
.marca-publica { display: inline-block; margin-bottom: 20px; color: var(--verde-oscuro); font-weight: 800; font-size: 1.15rem; text-decoration: none; }
.centrado { text-align: center; }
.qr-imagen { width: min(100%, 280px); height: auto; background: #fff; padding: 10px; border: 1px solid var(--borde); border-radius: 10px; }
.qr-panel { display: grid; grid-template-columns: minmax(180px, 280px) 1fr; gap: 24px; align-items: center; }
.qr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
.qr-card { margin: 0; }
.qr-card h2 { margin-top: 12px; }
.enlace { color: var(--verde-oscuro); }
.credenciales { display: grid; gap: 5px; overflow-wrap: anywhere; }
.bloque-acceso { display: grid; gap: 8px; min-width: 180px; }
.acciones-tabla { display: grid; gap: 6px; }
.acciones-form input[type="number"] { width: 90px; font: inherit; padding: 7px; border: 1px solid var(--borde); border-radius: 8px; }
.meta-formulario { margin-top: 10px; }

@media (max-width: 720px) {
  .app { grid-template-columns: 1fr; }
  .lateral { flex-direction: row; flex-wrap: wrap; align-items: center; }
  .lateral nav { display: flex; flex: 1; overflow-x: auto; }
  .lateral nav a { white-space: nowrap; }
  .contenido { padding: 18px; }
  .qr-panel { grid-template-columns: 1fr; }
}

@media (min-width: 640px) {
  .formulario-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .confirmacion-registro { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "encabezado boton" "autorizacion boton"; align-items: center; gap: 4px 16px; }
  .confirmacion-registro-boton, .formulario .confirmacion-registro-boton { width: auto; min-width: 140px; justify-self: end; }
}
