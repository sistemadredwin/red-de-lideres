# Copia este archivo como .env.local y completa los valores.
# En Supabase: Project Settings → API (o "API Keys").

# Dirección del proyecto, por ejemplo https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública ("publishable" o "anon"). Es segura para el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave secreta ("secret" o "service_role"). SOLO servidor: nunca la pongas en el código
# ni en una variable que empiece por NEXT_PUBLIC_. Sirve para crear cuentas de acceso.
SUPABASE_SECRET_KEY=

# Dominio interno con el que se arma el correo de cada persona (<cédula>@dominio).
# Debe ser el mismo con el que creaste al primer administrador.
NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN=campana.local

# Dirección pública de la aplicación (para el enlace del QR). En desarrollo déjala vacía.
# Ejemplo en producción: https://registro.tudominio.com
NEXT_PUBLIC_SITE_URL=
